package com.oppocts.ui

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.widget.Button
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import com.google.android.material.switchmaterial.SwitchMaterial
import com.oppocts.R
import com.oppocts.service.OverlayTriggerService
import com.oppocts.shizuku.AssistantSetter
import com.oppocts.shizuku.GmsFlagSetter
import com.oppocts.shizuku.ShizukuHelper

class SettingsActivity : AppCompatActivity() {

    private lateinit var tvStatusShizuku: TextView
    private lateinit var tvStatusAssistant: TextView
    private lateinit var tvStatusOverlay: TextView
    private lateinit var tvStatusAccessibility: TextView

    private lateinit var switchOverlayTrigger: SwitchMaterial
    private lateinit var switchAccessibilityTrigger: SwitchMaterial

    private lateinit var btnReapplyAssistant: Button
    private lateinit var btnReapplyFlags: Button
    private lateinit var btnRestartWizard: Button

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_settings)

        initViews()
        setupListeners()
    }

    override fun onResume() {
        super.onResume()
        updateStatus()
    }

    private fun initViews() {
        tvStatusShizuku = findViewById(R.id.tv_status_shizuku)
        tvStatusAssistant = findViewById(R.id.tv_status_assistant)
        tvStatusOverlay = findViewById(R.id.tv_status_overlay)
        tvStatusAccessibility = findViewById(R.id.tv_status_accessibility)

        switchOverlayTrigger = findViewById(R.id.switch_overlay_trigger)
        switchAccessibilityTrigger = findViewById(R.id.switch_accessibility_trigger)

        btnReapplyAssistant = findViewById(R.id.btn_reapply_assistant)
        btnReapplyFlags = findViewById(R.id.btn_reapply_flags)
        btnRestartWizard = findViewById(R.id.btn_restart_wizard)

        val prefs = getSharedPreferences("cts_prefs", Context.MODE_PRIVATE)
        switchOverlayTrigger.isChecked = prefs.getBoolean("use_overlay_trigger", true)
        switchAccessibilityTrigger.isChecked = prefs.getBoolean("use_accessibility_trigger", false)
    }

    private fun setupListeners() {
        val prefs = getSharedPreferences("cts_prefs", Context.MODE_PRIVATE)

        switchOverlayTrigger.setOnCheckedChangeListener { _, isChecked ->
            prefs.edit().putBoolean("use_overlay_trigger", isChecked).apply()
            val serviceIntent = Intent(this, OverlayTriggerService::class.java)
            if (isChecked) {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && !Settings.canDrawOverlays(this)) {
                    Toast.makeText(this, "オーバーレイの表示権限が必要です", Toast.LENGTH_SHORT).show()
                    val intent = Intent(
                        Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                        Uri.parse("package:$packageName")
                    )
                    startActivity(intent)
                    switchOverlayTrigger.isChecked = false
                } else {
                    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                        startForegroundService(serviceIntent)
                    } else {
                        startService(serviceIntent)
                    }
                }
            } else {
                stopService(serviceIntent)
            }
        }

        switchAccessibilityTrigger.setOnCheckedChangeListener { _, isChecked ->
            prefs.edit().putBoolean("use_accessibility_trigger", isChecked).apply()
            if (isChecked) {
                Toast.makeText(this, "ユーザー補助設定でOPPO CTSを有効にしてください", Toast.LENGTH_SHORT).show()
                startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
            }
        }

        btnReapplyAssistant.setOnClickListener {
            val success = AssistantSetter.setGoogleAssistant()
            if (success) {
                Toast.makeText(this, "デフォルトアシスタントをGoogleに変更しました", Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(this, "アシスタントの変更に失敗しました（Shizukuを確認してください）", Toast.LENGTH_SHORT).show()
            }
            updateStatus()
        }

        btnReapplyFlags.setOnClickListener {
            val success = GmsFlagSetter.enableCtsFlags()
            if (success) {
                Toast.makeText(this, "GMSフラグを設定しました（CTS有効化）", Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(this, "GMSフラグの設定に失敗しました", Toast.LENGTH_SHORT).show()
            }
        }

        btnRestartWizard.setOnClickListener {
            prefs.edit().putBoolean("setup_completed", false).apply()
            startActivity(Intent(this, SetupWizardActivity::class.java))
            finish()
        }
    }

    private fun updateStatus() {
        // Shizuku ステータス
        val isShizukuRunning = ShizukuHelper.isShizukuRunning()
        tvStatusShizuku.text = if (isShizukuRunning) {
            "Shizuku: 実行中 (権限あり)"
        } else {
            "Shizuku: 停止中または未接続"
        }

        // アシスタント ステータス
        tvStatusAssistant.text = "アシスタント: Google (設定済み)"

        // オーバーレイ権限
        val canDraw = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            Settings.canDrawOverlays(this)
        } else {
            true
        }
        tvStatusOverlay.text = if (canDraw) {
            "オーバーレイ権限: 許可済み"
        } else {
            "オーバーレイ権限: 未許可"
        }

        // ユーザー補助
        tvStatusAccessibility.text = "ユーザー補助サービス: 設定アプリで確認可能"
    }
}
