<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ヘッダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OPPO CTS 設定"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新" />
        </LinearLayout>

        <!-- ステータス一覧カード（GMS削除済み） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- アコーディオンヘッダー -->
                <LinearLayout
                    android:id="@+id/layout_status_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tv_main_status_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="設定ステータス: ✅"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_accordion_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp" />
                </LinearLayout>

                <!-- アコーディオン詳細コンテナ -->
                <LinearLayout
                    android:id="@+id/layout_status_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <!-- 1. Googleアプリ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_google_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ Google アプリ" />
                        <Button
                            android:id="@+id/btn_google_store"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="ストア" />
                    </LinearLayout>

                    <!-- 2. Google 音声認識と合成 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_speech_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ Google 音声認識と合成" />
                        <Button
                            android:id="@+id/btn_speech_store"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="ストア" />
                    </LinearLayout>

                    <!-- 3. Gemini -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_gemini_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ Gemini" />
                        <Button
                            android:id="@+id/btn_gemini_store"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="ストア" />
                    </LinearLayout>

                    <!-- 4. Shizuku -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_shizuku_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="Shizuku: 実行中" />
                        <Button
                            android:id="@+id/btn_shizuku_launch"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="起動" />
                    </LinearLayout>

                    <!-- 5. GMSフラグ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_flag_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ GMSフラグ" />
                        <Button
                            android:id="@+id/btn_reapply_flag"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="設定" />
                    </LinearLayout>

                    <!-- 6. アシスタント (ステップ6に合わせて繰り上げ) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_assistant_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="アシスタント: Google" />
                        <Button
                            android:id="@+id/btn_assistant_settings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="設定" />
                    </LinearLayout>

                    <!-- 7. 重ねて表示 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_overlay_permission_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ 重ねて表示" />
                        <Button
                            android:id="@+id/btn_overlay_settings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="設定" />
                    </LinearLayout>

                    <!-- 8. ユーザー補助 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_accessibility_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ ユーザー補助" />
                        <Button
                            android:id="@+id/btn_accessibility_settings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="設定" />
                    </LinearLayout>

                    <!-- 9. バックグラウンド -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp">
                        <TextView
                            android:id="@+id/tv_battery_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="15sp"
                            android:text="✅ バックグラウンド: 許可" />
                        <Button
                            android:id="@+id/btn_battery_settings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:paddingLeft="12dp"
                            android:paddingRight="12dp"
                            android:textSize="12sp"
                            android:text="設定" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 区切り線 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/dividerVertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- 初期セットアップを再実行 -->
                <Button
                    android:id="@+id/btn_rerun_setup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="初期セットアップを再実行" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- トリガー設定カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="かこって検索の起動方法"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/spinner_trigger_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <!-- ナビバー長押し用オーバーレイ調整 -->
                <LinearLayout
                    android:id="@+id/layout_overlay_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="オーバーレイバー調整"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_overlay_debug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="判定エリアを可視化（赤色表示）" />

                    <TextView
                        android:id="@+id/tv_height_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="バーの厚み (高さ): 70px"
                        android:layout_marginTop="12dp" />

                    <SeekBar
                        android:id="@+id/seekbar_overlay_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="150" />

                    <TextView
                        android:id="@+id/tv_offset_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="トリガー位置の調整: 0px"
                        android:layout_marginTop="12dp" />

                    <SeekBar
                        android:id="@+id/seekbar_overlay_offset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="200" />
                </LinearLayout>

                <!-- クイック設定タイル説明 -->
                <LinearLayout
                    android:id="@+id/layout_tile_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="8dp"
                    android:background="#15000000">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 クイック設定タイルの使い方\n端末の画面上部からコントロールセンターを引き下げ、編集メニューから「OPPO CTS」タイルを追加してご使用ください。"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- アプリアイコンタップ説明 -->
                <LinearLayout
                    android:id="@+id/layout_shortcut_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:padding="8dp"
                    android:background="#15000000">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="💡 設定画面の開き方\nアプリアイコンをタップすると直接CTSが起動します。設定画面に戻りたい場合は、ホーム画面のアイコンを長押しして表示される「設定」メニューからいつでも開くことができます。"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- 起動遅延設定 -->
                <LinearLayout
                    android:id="@+id/layout_delay_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/tv_delay_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="起動遅延時間: 200ms"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="パネルや画面が閉じるのを待ってから検索を開始します"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="4dp" />

                    <SeekBar
                        android:id="@+id/seekbar_trigger_delay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="10" />
                </LinearLayout>

                <!-- CTS起動テストボタン -->
                <Button
                    android:id="@+id/btn_test_cts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CTS起動テスト (即時実行)"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
