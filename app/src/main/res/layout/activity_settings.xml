<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ヘッダー（タイトルと更新ボタンが絶対に被らない横並びレイアウト） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OPPO CTS 設定"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新" />
        </LinearLayout>

        <!-- ステータス一覧カード（ウィザードの順序に完全一致） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ステータス (タップで設定へ移動)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- 1. GMS -->
                <TextView
                    android:id="@+id/tv_gms_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="GMS: 確認中..." />

                <!-- 2. Googleアプリ -->
                <TextView
                    android:id="@+id/tv_google_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="Google アプリ: 確認中..." />

                <!-- 3. Gemini -->
                <TextView
                    android:id="@+id/tv_gemini_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="Gemini: 確認中..." />

                <!-- 4. Shizuku -->
                <TextView
                    android:id="@+id/tv_shizuku_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="Shizuku: 確認中..." />

                <!-- 5. GMSフラグ -->
                <TextView
                    android:id="@+id/tv_flag_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="GMSフラグ: 確認中..." />

                <!-- 6. 重ねて表示 -->
                <TextView
                    android:id="@+id/tv_overlay_permission_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="重ねて表示: 確認中..." />

                <!-- 7. ユーザー補助 -->
                <TextView
                    android:id="@+id/tv_accessibility_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="ユーザー補助: 確認中..." />

                <!-- 8. アシスタント -->
                <TextView
                    android:id="@+id/tv_assistant_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="アシスタント: 確認中..." />

                <!-- 9. バックグラウンド実行 -->
                <TextView
                    android:id="@+id/tv_battery_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="6dp"
                    android:textSize="15sp"
                    android:text="バックグラウンド実行: 確認中..." />

                <!-- 区切り線 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/dividerVertical"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- 初期セットアップを再実行（ステータスカード最下部） -->
                <Button
                    android:id="@+id/btn_rerun_setup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="初期セットアップを再実行" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- トリガー設定カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="トリガー方式"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/spinner_trigger_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="オーバーレイバー調整"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_overlay_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="判定エリアを可視化（赤色表示）" />

                <TextView
                    android:id="@+id/tv_height_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="バーの厚み (高さ): 70px"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekbar_overlay_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="150" />

                <TextView
                    android:id="@+id/tv_offset_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="トリガー位置の調整: 0px"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekbar_overlay_offset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200" />

                <Button
                    android:id="@+id/btn_test_cts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CTS起動テスト (即時実行)"
                    android:layout_marginTop="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
