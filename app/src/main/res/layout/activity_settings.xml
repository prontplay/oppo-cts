<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPPO CTS 設定"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- システム状態カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="システム状態"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_google_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Googleアプリ: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_gms_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GMS: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_shizuku_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shizuku: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_accessibility_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ユーザー補助サービス: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_assistant_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="デフォルトアシスタント: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_flag_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GMSフラグ: 確認中..." />

                <Button
                    android:id="@+id/btn_refresh"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状態を再読み込み"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- トリガー設定カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="トリガー方式"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Spinner
                    android:id="@+id/spinner_trigger_method"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ナビゲーションバー透明エリア設定"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_overlay_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="判定エリアを可視化（デバッグ表示）" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="バーの高さ (厚み)"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seekbar_overlay_height"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="200" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Y軸オフセット (上下位置)"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seekbar_overlay_offset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- テスト & 操作カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="テスト &amp; 管理"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_test_cts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CTS起動テスト (即時実行)"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_open_accessibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ユーザー補助設定を開く"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_rerun_setup"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="初期セットアップを再実行"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_key_test"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="キーイベントテスト"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_intent_test"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="インテントテスト"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_key_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
