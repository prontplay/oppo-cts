<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPPO CTS 設定"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- システム状態カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="システム状態"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_status_shizuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shizuku: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_status_assistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="アシスタント: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_status_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="オーバーレイ権限: 確認中..."
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_status_accessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ユーザー補助サービス: 確認中..." />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- トリガー方式カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="トリガー方式"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_overlay_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ナビゲーションバー長押し (推奨)" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="画面最下部の透明な領域を長押ししてCircle to Searchを起動します。"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_accessibility_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ユーザー補助サービスによるトリガー" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="キー入力やユーザー補助イベントを検知して起動します。"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 修復カード -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修復 &amp; クイック適用"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_reapply_assistant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="デフォルトアシスタントをGoogleに変更"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_reapply_flags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GMSフラグを再適用 (CTS有効化)"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btn_restart_wizard"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="初期セットアップウィザードを再実行" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
